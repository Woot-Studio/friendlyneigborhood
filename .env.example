# Salin ke .env. Jangan masukkan berkas ini ke git.
# Tanpa variabel di bawah, aplikasi berjalan dalam mode contoh (data Kel. Tomang).

# Sesi lokal. Di produksi gunakan string acak yang panjang.
SESSION_SECRET=

# Supabase. Kosongkan untuk mode demo di memori.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API Indonesia. Hanya dibaca di server. Rp2 per permintaan berhasil.
API_INDONESIA_KEY=

# Ringkasan AI. Kosongkan untuk ringkasan templat dari angka agregat.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Web Push lewat FCM. Buat kunci VAPID di Firebase Console > Cloud Messaging > Web Push certificates.
PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Rahasia untuk /api/cron/poll. Vercel Cron mengirimnya sebagai Bearer.
CRON_SECRET=

# URL publik aplikasi, dipakai Edge Function untuk meneruskan cron.
APP_URL=http://127.0.0.1:43721
