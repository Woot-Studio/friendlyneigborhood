{
	"name": "friendly-neighborhood",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun scripts/attach-cron.ts",
		"preview": "bun run build && wrangler dev --port 43721",
		"deploy": "bun run build && wrangler deploy",
		"deploy:pages": "CF_PAGES=1 vite build && wrangler pages deploy .svelte-kit/cloudflare --project-name friendly-neighborhood",
		"cf-typegen": "wrangler types",
		"d1:migrate:local": "wrangler d1 migrations apply DB --local",
		"d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test",
		"seed": "bun scripts/seed.ts",
		"seed:wilayah": "bun scripts/seed-wilayah.ts",
		"poll": "bun scripts/poll.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.6",
		"@types/web-push": "^3.6.4",
		"puppeteer-core": "^25.17.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.160.1"
	},
	"dependencies": {
		"@fontsource/plus-jakarta-sans": "^5.3.0",
		"@lucide/svelte": "^1.72.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.0",
		"leaflet": "^1.9.4",
		"web-push": "^4.0.0"
	}
}
